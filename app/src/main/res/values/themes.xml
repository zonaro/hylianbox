<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Technical base is Material 3 (material library 1.14.0); the expressive
         styling requirements are superseded by the custom Nintendo Switch UI
         (see AGENTS.md "Visual Standard"). We keep a plain DayNight parent so
         the Switch color tokens drive every screen. -->
    <style name="Theme.HylianBox" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Window -->
        <item name="android:windowBackground">@color/switch_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Material 3 color tokens (remapped to Switch equivalents) -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_on_error</item>
        <item name="android:colorBackground">@color/switch_bg</item>
        <item name="colorSurface">@color/switch_panel</item>
        <item name="colorOnSurface">@color/switch_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/switch_text_secondary</item>
        <item name="colorSurfaceContainer">@color/switch_panel</item>
        <item name="colorSurfaceContainerHigh">@color/switch_panel</item>
        <item name="colorSurfaceVariant">@color/switch_panel</item>

        <!-- Bottom-sheet dialog (hack detail) -->
        <item name="bottomSheetDialogTheme">@style/Theme.HylianBox.BottomSheet</item>
    </style>

    <!-- Runtime-selected accent overlays. ScaledAppCompatActivity applies exactly one before
         inflation, so Android, AppCompat and Material controls share the user's accent instead of
         falling back to the historical cyan/amber theme tokens. -->
    <style name="ThemeOverlay.HylianBox.Accent.Cyan" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryContainer">@color/accent_cyan</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="android:colorAccent">@color/accent_cyan</item>
        <item name="colorControlActivated">@color/accent_cyan</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorOnPrimaryContainer">@android:color/black</item>
    </style>

    <style name="ThemeOverlay.HylianBox.Accent.GreenLight" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/accent_green_light</item>
        <item name="colorPrimaryContainer">@color/accent_green_light</item>
        <item name="colorSecondary">@color/accent_green_light</item>
        <item name="colorAccent">@color/accent_green_light</item>
        <item name="android:colorAccent">@color/accent_green_light</item>
        <item name="colorControlActivated">@color/accent_green_light</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorOnPrimaryContainer">@android:color/black</item>
    </style>

    <style name="ThemeOverlay.HylianBox.Accent.GreenDark" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/accent_green_dark</item>
        <item name="colorPrimaryContainer">@color/accent_green_dark</item>
        <item name="colorSecondary">@color/accent_green_dark</item>
        <item name="colorAccent">@color/accent_green_dark</item>
        <item name="android:colorAccent">@color/accent_green_dark</item>
        <item name="colorControlActivated">@color/accent_green_dark</item>
    </style>

    <style name="ThemeOverlay.HylianBox.Accent.Blue" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryContainer">@color/accent_blue</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:colorAccent">@color/accent_blue</item>
        <item name="colorControlActivated">@color/accent_blue</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorOnPrimaryContainer">@android:color/black</item>
    </style>

    <style name="ThemeOverlay.HylianBox.Accent.Yellow" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/accent_yellow</item>
        <item name="colorPrimaryContainer">@color/accent_yellow</item>
        <item name="colorSecondary">@color/accent_yellow</item>
        <item name="colorAccent">@color/accent_yellow</item>
        <item name="android:colorAccent">@color/accent_yellow</item>
        <item name="colorControlActivated">@color/accent_yellow</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorOnPrimaryContainer">@android:color/black</item>
    </style>

    <style name="ThemeOverlay.HylianBox.Accent.Pink" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/accent_pink</item>
        <item name="colorPrimaryContainer">@color/accent_pink</item>
        <item name="colorSecondary">@color/accent_pink</item>
        <item name="colorAccent">@color/accent_pink</item>
        <item name="android:colorAccent">@color/accent_pink</item>
        <item name="colorControlActivated">@color/accent_pink</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorOnPrimaryContainer">@android:color/black</item>
    </style>

    <style name="ThemeOverlay.HylianBox.Accent.Red" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorPrimaryContainer">@color/accent_red</item>
        <item name="colorSecondary">@color/accent_red</item>
        <item name="colorAccent">@color/accent_red</item>
        <item name="android:colorAccent">@color/accent_red</item>
        <item name="colorControlActivated">@color/accent_red</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorOnPrimaryContainer">@android:color/black</item>
    </style>

    <style name="ThemeOverlay.HylianBox.Accent.Violet" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/accent_violet</item>
        <item name="colorPrimaryContainer">@color/accent_violet</item>
        <item name="colorSecondary">@color/accent_violet</item>
        <item name="colorAccent">@color/accent_violet</item>
        <item name="android:colorAccent">@color/accent_violet</item>
        <item name="colorControlActivated">@color/accent_violet</item>
    </style>

    <style name="ThemeOverlay.HylianBox.Accent.Teal" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorPrimaryContainer">@color/accent_teal</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorAccent">@color/accent_teal</item>
        <item name="android:colorAccent">@color/accent_teal</item>
        <item name="colorControlActivated">@color/accent_teal</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorOnPrimaryContainer">@android:color/black</item>
    </style>

    <style name="ThemeOverlay.HylianBox.Accent.Orange" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorPrimaryContainer">@color/accent_orange</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="colorAccent">@color/accent_orange</item>
        <item name="android:colorAccent">@color/accent_orange</item>
        <item name="colorControlActivated">@color/accent_orange</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorOnPrimaryContainer">@android:color/black</item>
    </style>

    <style name="ThemeOverlay.HylianBox.Accent.Purple" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorPrimaryContainer">@color/accent_purple</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorAccent">@color/accent_purple</item>
        <item name="android:colorAccent">@color/accent_purple</item>
        <item name="colorControlActivated">@color/accent_purple</item>
    </style>

    <style name="ThemeOverlay.HylianBox.Accent.Indigo" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/accent_indigo</item>
        <item name="colorPrimaryContainer">@color/accent_indigo</item>
        <item name="colorSecondary">@color/accent_indigo</item>
        <item name="colorAccent">@color/accent_indigo</item>
        <item name="android:colorAccent">@color/accent_indigo</item>
        <item name="colorControlActivated">@color/accent_indigo</item>
    </style>

    <!-- Splash theme. References @drawable/splash_artwork; a temporary solid
         placeholder drawable ships until Dolfi delivers the real PNG. -->
    <style name="Theme.HylianBox.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_artwork</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Bottom-sheet: transparent container so the sheet's own rounded
         surfaceContainerHigh background (drawn by the fragment) shows. -->
    <style name="Theme.HylianBox.BottomSheet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/StoreBottomSheetAnimation</item>
        <item name="bottomSheetStyle">@style/Widget.HylianBox.BottomSheet</item>
    </style>

    <style name="Widget.HylianBox.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Fullscreen hack-detail dialog (replaces the old bottom sheet): fills the
         screen, Switch background, fade animation. -->
    <style name="StoreDetailFullscreen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/switch_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowAnimationStyle">@style/SwitchDialogAnimation</item>
    </style>

    <style name="StoreBottomSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_up</item>
        <item name="android:windowExitAnimation">@anim/slide_out_down</item>
    </style>

    <!-- Section header used inside the Plandomizer visual builder. -->
    <style name="PlandomizerSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Shared settings row containers (DRY for row_setting_*).
         An explicit parent is required: on this AAPT2 version parent="" does
         NOT suppress the implicit parent lookup that a dotted style name
         triggers, so "Widget.HylianBox.SettingRow" would otherwise look up the
         non-existent base "Widget.HylianBox" (and then "Widget") and fail linking. -->
    <style name="Widget.HylianBox.SettingRow" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.HylianBox.SettingRow.Horizontal" parent="Widget.HylianBox.SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Shared label for settings rows: surface-on color + expressive body. -->
    <style name="Widget.HylianBox.SettingLabel" parent="android:Widget">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>

    <!-- Flat Switch-style button (replaces the expressive M3 pill button). -->
    <style name="SwitchButton" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_switch_button_focus</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Flat Switch-style toggle, tinted with the Switch accent token. -->
    <style name="SwitchSwitch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="android:thumbTint">@color/switch_thumb</item>
        <item name="android:trackTint">@color/switch_track</item>
    </style>

    <!-- Switch section header: small, secondary, uppercase label. -->
    <style name="SwitchSectionHeader" parent="android:Widget.TextView">
        <item name="android:textColor">@color/switch_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Fixed sidebar / portrait drawer category rows for Settings. -->
    <style name="SwitchSettingsNavigationRow" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_settings_nav_row</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:ellipsize">end</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/switch_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Flat Switch-style text field (replaces the expressive M3 outlined box). -->
    <style name="SwitchTextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/switch_text_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/switch_text_secondary</item>
        <item name="android:textColorHint">@color/switch_text_secondary</item>
        <item name="editTextStyle">@style/SwitchEditText</item>
    </style>

    <!-- Text color for fields hosted inside a SwitchTextField. -->
    <style name="SwitchEditText" parent="android:Widget.EditText">
        <item name="android:textColor">@color/switch_text_primary</item>
    </style>

    <!-- Transparent, floating window for the reusable SwitchDialog. -->
    <style name="SwitchDialogTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/SwitchDialogAnimation</item>
    </style>

    <!-- Modal lifecycle with normal-screen geometry for every surface opened over gameplay. -->
    <style name="GameplayFullscreenDialogTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/switch_bg</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:backgroundDimAmount">0</item>
        <item name="android:windowAnimationStyle">@style/SwitchDialogAnimation</item>
    </style>

    <style name="SwitchDialogAnimation">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>
