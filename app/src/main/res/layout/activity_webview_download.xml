<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/switch_bg"
    android:orientation="vertical">

    <!-- Toolbar: close (X circular) + back + title — X sempre antes do título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/switch_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/webview_close"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/detail_close_desc"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            android:tint="@color/switch_text_primary" />

        <ImageButton
            android:id="@+id/webview_back"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/webview_back_desc"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_previous"
            android:tint="@color/switch_text_primary" />

        <TextView
            android:id="@+id/webview_toolbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:textColor="@color/switch_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Progress bar + text shown while downloading/installing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/switch_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ProgressBar
            android:id="@+id/webview_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/webview_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/switch_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
